# =============================================================================
# Supabase Database Configuration for AGM 2026 Invitation
# =============================================================================
# Find these in your Supabase Dashboard:
# Project Settings -> API
# -----------------------------------------------------------------------------

# Supabase Project URL (e.g. https://xyzabcdef.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 'anon' public key (Project Settings -> API -> Project API keys -> anon public)
SUPABASE_ANON_KEY=your-anon-public-key-here

# Table name for recording responses (default: rsvp_responses)
RSVP_TABLE=rsvp_responses
